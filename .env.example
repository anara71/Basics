# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database Configuration
# For SQLite (default):
# SQLALCHEMY_DATABASE_URI=sqlite:///billionaire_tracker.db

# For PostgreSQL:
# SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost/billionaire_tracker

# For MySQL:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://username:password@localhost/billionaire_tracker

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
